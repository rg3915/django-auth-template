[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_name }}"
readme = "README.md"
requires-python = ">=3.14"
dependencies = [
    "dj-database-url>=3.1.2",
    "django>=6.1.1",
{%- if database == 'postgres' %}
    "psycopg[binary]>=3.3.6",
{%- endif %}
    "python-decouple>=3.8",
]
